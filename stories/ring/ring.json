  "shots": [
    {"vo": "On their wedding day, he slipped a strange ring onto her finger.",
     "set": {"type": "outdoor", "sky": "day", "ground": "grass", "horizon": 0.55},
     "props": [{"type": "crowd", "x": 0.5, "y": 0.66, "s": 0.7, "n": 6, "cheer": true, "z": 0.5}],
     "actors": [{"who": "sam", "x": 0.32, "mood": "happy", "pose": "reach", "facing": 1, "reach": 0.6}, {"who": "lily", "x": 0.68, "mood": "happy", "facing": -1, "fx": ["hearts"]}],
     "cam": {"z": [1.0, 1.1]}},
    {"vo": "He explained that it would tighten whenever the other person lied.",
     "set": {"type": "outdoor", "sky": "day", "ground": "grass", "horizon": 0.55},
     "actors": [{"who": "sam", "x": 0.32, "mood": "smug", "pose": "present", "facing": 1, "talk": 0.5}, {"who": "lily", "x": 0.68, "mood": "think", "facing": -1}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "She laughed, but she put it on.",
     "insert": {"type": "hand", "tight": 0.0},
     "cam": {"z": [1.0, 1.15], "fy": 0.45}},
    {"vo": "That first night, she felt it squeeze. Just a little.",
     "set": {"type": "room", "wall": [120, 130, 190], "floor": "carpet", "carpet": [80, 70, 110], "window": "night"},
     "props": [{"type": "bed", "x": 0.5, "y": 0.9, "z": 0.5}],
     "actors": [{"who": "sam", "x": 0.24, "mood": "neutral", "sleep": true, "y": 0.705, "h": 380, "z": 0.6}, {"who": "lily", "x": 0.47, "mood": "neutral", "sleep": true, "eyes": "open", "y": 0.705, "h": 380, "z": 0.61}],
     "fx": ["night"],
     "cam": {"z": [1.0, 1.2], "fx": 0.4, "fy": 0.7}},
    {"vo": "She looked at her husband, but he was sound asleep.",
     "set": {"type": "room", "wall": [120, 130, 190], "floor": "carpet", "carpet": [80, 70, 110], "window": "night"},
     "props": [{"type": "bed", "x": 0.5, "y": 0.9, "z": 0.5}],
     "actors": [{"who": "sam", "x": 0.24, "mood": "neutral", "sleep": true, "y": 0.705, "h": 380, "z": 0.6}, {"who": "lily", "x": 0.47, "mood": "neutral", "sleep": true, "eyes": "open", "y": 0.705, "h": 380, "z": 0.61}],
     "fx": ["night"],
     "cam": {"z": [1.3, 1.6], "fx": 0.3, "fy": 0.7}},
    {"vo": "The next day, it squeezed again. Then again at dinner. Then every single morning.",
     "insert": {"type": "hand", "tight": [0.1, 0.35]},
     "cam": {"z": [1.0, 1.1], "shake": 2}},
    {"vo": "Her finger started turning red. She checked his phone while he showered.",
     "set": {"type": "room", "wall": [245, 215, 200], "window": "day"},
     "props": [{"type": "phone", "x": 0.62, "y": 0.62, "s": 1.2, "z": 0.95}],
     "actors": [{"who": "lily", "x": 0.45, "mood": "nervous", "pose": "hold", "fx": ["sweat"]}],
     "cam": {"z": [1.0, 1.12]}},
    {"vo": "Nothing. She followed him to work. Nothing.",
     "set": {"type": "outdoor", "sky": "day", "ground": "street", "city": true, "horizon": 0.5},
     "actors": [{"who": "sam", "x": [0.25, 0.55], "mood": "happy", "walk": 1.6, "h": 420, "y": 0.78, "facing": 1}, {"who": "lily", "x": 0.88, "mood": "angry", "y": 0.95, "h": 560, "facing": -1, "lean": -0.15}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "She even hired a private investigator. He came back with nothing at all. Her husband was perfect.",
     "set": {"type": "room", "wall": [110, 90, 80], "floor": "wood", "lamp": 0.5},
     "props": [{"type": "clipboard", "x": 0.42, "y": 0.66, "s": 1.0, "z": 0.95}],
     "actors": [{"who": "pi", "x": 0.3, "mood": "neutral", "pose": "shrug"}, {"who": "lily", "x": 0.72, "mood": "nervous", "facing": -1}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "But the ring kept getting tighter.",
     "insert": {"type": "hand", "tight": [0.4, 0.65]},
     "fx": ["red"],
     "cam": {"z": [1.0, 1.2], "shake": 4}},
    {"vo": "Now her finger was turning purple. She couldn't sleep. She couldn't eat.",
     "set": {"type": "room", "wall": [120, 130, 190], "window": "night"},
     "props": [{"type": "table", "x": 0.5, "y": 0.95, "s": 1.2, "items": ["plate"], "z": 0.99}],
     "actors": [{"who": "lily", "x": 0.5, "mood": "tired", "y": 0.82, "fx": ["sweat"]}],
     "fx": ["night"],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "She stopped trusting anyone. Every time he said he loved her, she flinched.",
     "set": {"type": "room", "wall": [245, 215, 200], "window": "day"},
     "actors": [{"who": "sam", "x": 0.3, "mood": "happy", "pose": "present", "facing": 1, "fx": ["hearts"], "talk": 0.5}, {"who": "lily", "x": 0.7, "mood": "nervous", "facing": -1, "lean": 0.2}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Finally, she couldn't take the pain anymore, so she went to a jeweler to cut it off.",
     "set": {"type": "room", "wall": [40, 90, 80], "floor": "carpet", "carpet": [60, 30, 40], "lamp": 0.5},
     "props": [{"type": "counter", "x": 0.5, "y": 0.9, "w": 0.8, "color": [90, 50, 30], "z": 0.7}],
     "actors": [{"who": "jeweler", "x": 0.6, "mood": "think", "y": 0.7, "h": 480, "z": 0.6}, {"who": "lily", "x": 0.25, "mood": "sad", "pose": "present", "z": 0.9}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "As the ring snapped open, he handed her the original box.",
     "insert": {"type": "hand", "tight": [0.7, 0.0]},
     "fx": ["flash"],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Folded inside was a tiny card she had never read. Tightens when the wearer lies.",
     "insert": {"type": "card", "box": true, "text": "Tightens when the WEARER lies.", "size": 70},
     "cam": {"z": [1.0, 1.2], "fy": 0.42},
     "sfx": [{"type": "boom", "word": "lies."}]},
    {"vo": "Every morning, she had told him, I trust you.",
     "set": {"type": "room", "wall": [245, 215, 200], "window": "day"},
     "actors": [{"who": "sam", "x": 0.3, "mood": "happy", "facing": 1}, {"who": "lily", "x": 0.68, "mood": "happy", "facing": -1, "talk": 0.6}],
     "fx": ["red"],
     "cam": {"z": [1.0, 1.3], "fx": 0.68, "fy": 0.6}}
  ]
