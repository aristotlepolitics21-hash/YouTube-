     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Never open the basement on the first. Every other day, leave a plate of meat at the top of the stairs.",
     "insert": {"type": "note", "bg": [80, 60, 45], "write": true, "size": 60, "h": 1000, "lines": ["Never open the basement on the 1st.", "Every other day, leave a plate of meat at the top of the stairs.", "- Grandpa"]},
     "cam": {"z": [1.0, 1.1]}},
    {"vo": "She thought he was just a strange old man. But every morning, the plate was licked clean.",
