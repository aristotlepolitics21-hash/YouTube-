     "cam": {"z": [1.0, 1.15], "fy": 0.3}},
    {"vo": "The house was silent. She stood at the basement door with her hand on the knob, then stepped back.",
     "set": {"type": "room", "wall": [150, 165, 140], "stripes": true, "floor": "wood", "window": "day", "window_rect": [0.06, 0.14, 0.3, 0.18]},
     "props": [{"type": "door", "x": 0.68, "y": 0.84, "note": true, "z": 0.4}],
