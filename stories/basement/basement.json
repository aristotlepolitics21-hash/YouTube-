     "props": [{"type": "door", "x": 0.68, "y": 0.84, "note": true, "z": 0.4}, {"type": "plate", "x": 0.52, "y": 0.86, "food_color": [170, 40, 50], "z": 0.95}],
     "actors": [{"who": "ruth", "x": 0.32, "mood": "nervous", "facing": 1, "pose": "reach", "reach": 0.4}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Then she got busy. She forgot one day, then two.",
     "set": {"type": "room", "wall": [150, 165, 140], "stripes": true, "floor": "wood", "window": "day", "window_rect": [0.06, 0.14, 0.3, 0.18]},
     "props": [{"type": "door", "x": 0.68, "y": 0.84, "note": true, "z": 0.4}, {"type": "plate", "x": 0.52, "y": 0.86, "food": false, "z": 0.95}],
     "actors": [{"who": "ruth", "x": [0.0, 0.35], "mood": "happy", "walk": 1.8, "pose": "hold", "facing": 1}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "On the third night, she heard scratching behind the basement door. Slow. Patient. Then it stopped.",
     "set": {"type": "room", "wall": [150, 165, 140], "stripes": true, "floor": "wood", "window": "night", "window_rect": [0.06, 0.14, 0.3, 0.18]},
