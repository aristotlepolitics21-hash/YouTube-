  "shots": [
    {"vo": "At 3 a.m., the elevator in his apartment building showed a button for floor 13.",
     "insert": {"type": "panel", "lit": 13, "on": true},
     "fx": ["dark"],
     "cam": {"z": [1.0, 1.2], "fy": 0.25}},
    {"vo": "The building only had 12 floors. He pressed it.",
     "insert": {"type": "panel", "lit": 13, "finger": true, "press_at": 0.75},
     "cam": {"z": [1.0, 1.1], "fy": 0.3},
     "sfx": [{"type": "pop", "word": "it."}]},
    {"vo": "The doors opened to a quiet hallway with soft music and expensive carpet.",
     "set": {"type": "hallway", "lux": true, "doors": ["", "", "", ""]},
     "actors": [{"who": "dan", "x": 0.5, "mood": "shock", "y": 0.95, "h": 600}],
     "fx": ["warm"],
     "cam": {"z": [1.0, 1.1]}},
    {"vo": "At the end was a lounge with free food, warm lights, and the most comfortable couch he had ever sat on.",
     "set": {"type": "room", "wall": [120, 30, 45], "floor": "carpet", "carpet": [150, 20, 35], "lamp": 0.5, "picture": true},
     "props": [{"type": "lounge", "x": 0.5, "y": 0.92, "z": 0.5}],
     "actors": [{"who": "dan", "x": 0.5, "mood": "happy", "y": 0.8, "z": 0.4, "fx": ["hearts"]}],
     "fx": ["warm"],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "He fell asleep there and woke up back in his own bed.",
     "set": {"type": "room", "wall": [170, 185, 225], "floor": "carpet", "carpet": [90, 80, 120], "window": "day"},
     "props": [{"type": "bed", "x": 0.5, "y": 0.9, "z": 0.5}],
     "actors": [{"who": "dan", "x": 0.27, "mood": "neutral", "sleep": true, "eyes": "open", "y": 0.705, "h": 380, "z": 0.6}],
     "cam": {"z": [1.0, 1.2], "fx": 0.3, "fy": 0.68}},
    {"vo": "So he went back the next night. And the next.",
     "set": {"type": "elevator", "lit": 13},
     "actors": [{"who": "dan", "x": 0.5, "mood": "smug", "h": 640, "y": 0.95}],
     "cam": {"z": [1.0, 1.1]}},
    {"vo": "You see, every visit felt better than the last.",
     "set": {"type": "room", "wall": [120, 30, 45], "floor": "carpet", "carpet": [150, 20, 35], "lamp": 0.5},
     "props": [{"type": "lounge", "x": 0.5, "y": 0.92, "z": 0.5}],
     "actors": [{"who": "dan", "x": 0.5, "mood": "laugh", "pose": "cheer", "y": 0.8, "z": 0.4}],
     "fx": ["warm"],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "But every time he came home, something in the building had changed.",
     "set": {"type": "room", "wall": [200, 195, 180], "floor": "tile"},
     "props": [{"type": "mailboxes", "x": 0.5, "y": 0.25, "names": ["PARK", "DIAZ", "COLE", "KIM", "SHAW", "MORRIS"]}],
     "actors": [{"who": "dan", "x": 0.5, "mood": "think", "y": 0.95, "h": 600}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "A neighbor had moved out. Then another.",
     "set": {"type": "room", "wall": [200, 195, 180], "floor": "tile"},
     "props": [{"type": "mailboxes", "x": 0.5, "y": 0.25, "names": ["", "DIAZ", "COLE", "", "SHAW", "MORRIS"]}],
     "actors": [{"who": "dan", "x": 0.5, "mood": "nervous", "y": 0.95, "h": 600}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Their names were peeled off the mailboxes like they had never lived there at all.",
     "set": {"type": "room", "wall": [200, 195, 180], "floor": "tile"},
     "props": [{"type": "mailboxes", "x": 0.5, "y": 0.42, "s": 1.4, "names": ["", "", "COLE", "", "", "MORRIS"]}],
     "cam": {"z": [1.0, 1.25], "fy": 0.45}},
    {"vo": "Then he noticed something on floor 13. A new door had appeared in the hallway, with a brass nameplate.",
     "set": {"type": "hallway", "lux": true, "doors": ["", "", "R. COLE", ""]},
     "actors": [{"who": "dan", "x": 0.5, "mood": "shock", "y": 0.97, "h": 560}],
     "fx": ["warm"],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "It was his neighbor's name.",
     "insert": {"type": "door", "name": "R. COLE"},
     "cam": {"z": [1.0, 1.25], "fy": 0.3}},
    {"vo": "The next night, there were two new doors. Then five.",
     "set": {"type": "hallway", "lux": true, "doors": ["P. PARK", "R. COLE", "L. DIAZ", "A. KIM", "T. SHAW", "J. LUNA"]},
     "fx": ["warm"],
     "cam": {"z": [1.0, 1.2]}},
    {"vo": "He decided he would never go back. He took the stairs for a week.",
     "set": {"type": "stairs"},
     "actors": [{"who": "dan", "x": 0.5, "mood": "nervous", "y": 0.98, "h": 560, "walk": 1.2, "fx": ["sweat"]}],
     "cam": {"z": [1.0, 1.1]}},
    {"vo": "Then, one night, he woke up in the elevator. Floor 13 was already lit.",
     "set": {"type": "elevator", "lit": 13, "flicker": true},
     "actors": [{"who": "dan", "x": 0.45, "mood": "shock", "h": 640, "y": 0.95, "pose": "flail"}],
     "cam": {"z": [1.0, 1.1], "shake": 4}},
    {"vo": "At the end of the hallway was a new door with his name on it.",
     "insert": {"type": "door", "name": "D. MORRIS"},
     "fx": ["red"],
     "cam": {"z": [1.0, 1.35], "fy": 0.3},
     "sfx": [{"type": "boom", "word": "it."}]}
  ]
}
