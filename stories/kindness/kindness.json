  },
  "shots": [
    {"vo": "The city installed an AI that scored how kind everyone was.",
     "set": {"type": "outdoor", "sky": "day", "ground": "street", "city": true, "horizon": 0.52},
     "props": [{"type": "sign", "x": 0.5, "y": 0.2, "text": "KINDNESS SCORE: ON", "w": 760, "color": [30, 40, 80], "ink": [90, 230, 140]}, {"type": "crowd", "x": 0.5, "y": 0.9, "s": 0.85, "n": 5}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Low scores lost things. Their phone plans. Their apartments. Their jobs.",
     "insert": {"type": "phone", "app": "KindScore", "app_color": [220, 60, 60], "stagger": 0.22, "items": [{"title": "Score 22", "text": "Phone plan suspended.", "style": "alert"}, {"title": "Score 22", "text": "Apartment lease cancelled.", "style": "alert"}, {"title": "Score 22", "text": "Employment terminated.", "style": "alert"}]},
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "High scores got everything. Free coffee. Better housing. Respect.",
     "set": {"type": "outdoor", "sky": "day", "ground": "street", "city": true, "horizon": 0.52},
     "props": [{"type": "crowd", "x": 0.5, "y": 0.92, "s": 0.9, "n": 5, "cheer": true, "mood": "laugh"}],
     "fx": ["warm"],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "He was a 41.",
     "insert": {"type": "score", "from": 41, "to": 41},
     "cam": {"z": [1.0, 1.1]}},
    {"vo": "So he started gaming the system. He filmed himself helping old ladies cross the street.",
     "set": {"type": "outdoor", "sky": "day", "ground": "street", "city": true, "horizon": 0.52},
     "props": [{"type": "phone", "x": 0.86, "y": 0.55, "s": 1.4, "z": 0.99}],
     "actors": [{"who": "ned", "x": 0.35, "mood": "smug", "pose": "reach", "facing": 1, "reach": 0.5}, {"who": "lady", "x": 0.64, "mood": "happy", "facing": -1}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "He donated money right in front of the cameras. He even adopted a dog he didn't really want.",
     "set": {"type": "outdoor", "sky": "day", "ground": "street", "city": true, "horizon": 0.52},
     "props": [{"type": "crowd", "x": 0.5, "y": 0.66, "s": 0.6, "n": 6, "cheer": true, "z": 0.2}],
     "actors": [{"who": "ned", "x": 0.5, "mood": "smug", "pose": "present", "h": 600, "y": 0.95}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "His score climbed. 70. 85. 96.",
     "insert": {"type": "score", "from": 41, "to": 96},
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Then one morning, he woke up to a notification.",
     "set": {"type": "room", "wall": [200, 220, 240], "floor": "carpet", "carpet": [90, 110, 150], "window": "day"},
     "props": [{"type": "bed", "x": 0.5, "y": 0.9, "z": 0.5}],
     "actors": [{"who": "ned", "x": 0.27, "mood": "neutral", "sleep": true, "eyes": "open", "y": 0.705, "h": 380, "z": 0.6}],
     "cam": {"z": [1.0, 1.15], "fx": 0.3, "fy": 0.68}},
    {"vo": "Congratulations. You are a perfect 100.",
     "insert": {"type": "score", "from": 96, "to": 100, "sub": "PERFECT CITIZEN"},
     "fx": ["warm"],
     "cam": {"z": [1.0, 1.08]},
     "sfx": [{"type": "pop", "word": "100."}]},
    {"vo": "Only three people in the entire city had ever reached a perfect score, and none of them had ever posted again.",
     "insert": {"type": "phone", "app": "Perfect 100 Club", "app_color": [60, 170, 110], "stagger": 0.15, "items": [{"title": "@grace_m  -  100", "text": "Last post: 2 years ago", "style": "note"}, {"title": "@omar.k  -  100", "text": "Last post: 14 months ago", "style": "note"}, {"title": "@tina.b  -  100", "text": "Last post: 6 months ago", "style": "note"}]},
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "That afternoon, a white van pulled up to his apartment.",
     "set": {"type": "outdoor", "sky": "day", "ground": "street", "city": true, "horizon": 0.52},
     "props": [{"type": "car", "x": [-0.3, 0.5], "y": 0.95, "van": true, "color": [245, 245, 248], "s": 1.1}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Two smiling people in clean uniforms said he had been selected for the Kindness Program.",
     "set": {"type": "outdoor", "sky": "day", "ground": "street", "city": true, "horizon": 0.52},
     "actors": [{"who": "staff1", "x": 0.22, "mood": "happy", "pose": "present", "facing": 1}, {"who": "staff2", "x": 0.48, "mood": "happy", "facing": 1}, {"who": "ned", "x": 0.78, "mood": "shock", "facing": -1}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "He would be honored at a special ceremony. He packed a bag and climbed in, grinning.",
     "set": {"type": "outdoor", "sky": "day", "ground": "street", "city": true, "horizon": 0.52},
     "props": [{"type": "car", "x": 0.62, "y": 0.95, "van": true, "color": [245, 245, 248], "s": 1.1, "z": 0.5}],
     "actors": [{"who": "ned", "x": [0.15, 0.45], "mood": "laugh", "walk": 1.6, "pose": "hold", "facing": 1, "z": 0.9}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "The building they took him to was quiet. Too quiet.",
     "set": {"type": "room", "wall": [235, 240, 245], "floor": "tile"},
     "actors": [{"who": "ned", "x": 0.5, "mood": "nervous", "h": 560, "y": 0.95, "look": [-0.6, -0.2]}],
     "cam": {"z": [1.0, 1.1]}},
    {"vo": "A nurse handed him a clipboard and a pen.",
     "set": {"type": "room", "wall": [235, 240, 245], "floor": "tile"},
     "props": [{"type": "clipboard", "x": 0.5, "y": 0.62, "z": 0.95}],
     "actors": [{"who": "nurse", "x": 0.28, "mood": "smug", "pose": "present", "facing": 1}, {"who": "ned", "x": 0.72, "mood": "happy", "facing": -1}],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "He looked down. It was a donor form, already filled out.",
     "insert": {"type": "note", "bg": [190, 200, 210], "paper": [255, 255, 255], "ink": [20, 20, 30], "lined": false, "size": 56, "lines": ["DONOR CONSENT FORM", "Name: Ned Fisher", "Kindness Score: 100", "Signature: Ned Fisher"]},
     "cam": {"z": [1.0, 1.1]}},
    {"vo": "Both kidneys. Liver. Heart.",
     "insert": {"type": "note", "bg": [190, 200, 210], "paper": [255, 255, 255], "ink": [180, 20, 30], "lined": false, "size": 76, "write": true, "lines": ["[X] Both kidneys", "[X] Liver", "[X] Heart"]},
     "fx": ["red"],
     "cam": {"z": [1.0, 1.15]},
     "sfx": [{"type": "boom", "word": "heart."}]},
    {"vo": "After all, a perfect citizen never says no.",
     "set": {"type": "room", "wall": [235, 240, 245], "floor": "tile"},
     "actors": [{"who": "nurse", "x": 0.28, "mood": "smug", "facing": 1}, {"who": "ned", "x": 0.72, "mood": "shock", "facing": -1, "fx": ["sweat"]}],
     "fx": ["red"],
     "cam": {"z": [1.0, 1.25], "fx": 0.3, "fy": 0.6}}
  ]
