     "actors": [{"who": "kai", "x": 0.23, "mood": "tired", "y": 0.75, "lean": 1.35}],
     "fx": ["bubbles"],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "Someone worried about a sunburn.",
