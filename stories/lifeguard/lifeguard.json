    {"vo": "She went under again. Help me. I'm stuck.",
     "set": {"type": "underwater"},
     "props": [{"type": "sign", "x": 0.5, "y": 0.25, "text": "Help me. I'm stuck.", "w": 640, "color": [255, 255, 255], "ink": [200, 20, 30]}],
     "actors": [{"who": "kai", "x": 0.23, "mood": "shock", "y": 0.68, "lean": 1.35}],
     "fx": ["bubbles"],
     "cam": {"z": [1.0, 1.08]}},
    {"vo": "She followed the voice down to the bottom of the deep end.",
