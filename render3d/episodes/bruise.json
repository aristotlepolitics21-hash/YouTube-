{
  "module": "bruise",
  "title": "Why Does a Bruise Change Color?",
  "music": "ambient",
  "length_scale": 1.08,
  "punch": 0.06,
  "max_clip": 2.6,
  "shots": [
    {
      "vo": "Why does a bruise change color?",
      "highlight": "#c9a43c",
      "scene": "spot",
      "params": {"s0": 0, "s1": 2},
      "cuts": [
        {"at": "change", "params": {"s0": 2, "s1": 4.2, "az0": 1.2, "az1": 1.0, "dist0": 15, "dist1": 13}}
      ]
    },
    {
      "vo": "When something hits you, tiny blood vessels under your skin break.",
      "highlight": "#ff4b4b",
      "scene": "impact",
      "params": {"hitAt": 0.55, "leak0": 0, "leak1": 0.1},
      "cuts": [
        {"at": "tiny", "params": {"hitAt": -1, "ball": 0, "leak0": 0.05, "leak1": 0.2, "az0": 0.1, "az1": 0.05, "dist0": 11, "dist1": 9, "ty0": -1.2, "ty1": -1.3, "tz0": 3, "tz1": 3}},
        {"at": "break", "params": {"hitAt": -1, "ball": 0, "leak0": 0.2, "leak1": 0.45, "az0": 0.6, "az1": 0.45, "dist0": 9, "dist1": 8, "ty0": -1.0, "ty1": -1.1, "tz0": 3, "tz1": 3}}
      ]
    },
    {
      "vo": "Blood leaks out and gets trapped in the tissue.",
      "highlight": "#ff4b4b",
      "scene": "impact",
      "params": {"hitAt": -1, "ball": 0, "leak0": 0.45, "leak1": 0.8, "az0": 0.2, "az1": 0.3, "dist0": 13, "dist1": 11, "ty0": -1.0, "ty1": -1.2, "tz0": 3, "tz1": 3},
      "cuts": [
        {"at": "trapped", "params": {"leak0": 0.8, "leak1": 1, "az0": -0.3, "az1": -0.15, "dist0": 18, "dist1": 16}}
      ]
    },
    {
      "vo": "At first it looks red, then purple and blue.",
      "highlight": "#ff4b4b",
      "scene": "spot",
      "params": {"s0": 0, "s1": 0.2},
      "cuts": [
        {"at": "purple", "params": {"s0": 0.8, "s1": 1.1, "az0": 2.0, "az1": 1.8}},
        {"at": "blue", "params": {"s0": 1.8, "s1": 2.1, "az0": -0.8, "az1": -0.6, "dist0": 15, "dist1": 14}}
      ]
    },
    {
      "vo": "Then cleanup cells called macrophages show up and eat it.",
      "highlight": "#7fd8ff",
      "scene": "macro",
      "params": {"eat0": 0, "eat1": 0.3},
      "cuts": [
        {"at": "macrophages", "params": {"eat0": 0.3, "eat1": 0.5, "az0": 0.8, "az1": 0.6, "dist0": 12, "dist1": 10, "ty0": 1.2, "ty1": 1.2, "tx0": -1.2, "tx1": -1.2}},
        {"at": "eat", "params": {"eat0": 0.5, "eat1": 1}}
      ]
    },
    {
      "vo": "They break down the red pigment, hemoglobin, into a green one called biliverdin.",
      "highlight": "#5dff9a",
      "scene": "pigment",
      "params": {"st0": 0, "st1": 0},
      "cuts": [
        {"at": "hemoglobin,", "params": {"st0": 0, "st1": 0, "az0": 0.9, "az1": 0.7, "dist0": 11, "dist1": 10}},
        {"at": "green", "params": {"st0": 0, "st1": 1}},
        {"at": "biliverdin", "scene": "spot", "params": {"s0": 2.6, "s1": 3.1, "dist0": 16, "dist1": 14}}
      ]
    },
    {
      "vo": "Then into yellow bilirubin.",
      "highlight": "#ffd23f",
      "scene": "pigment",
      "params": {"st0": 1, "st1": 2},
      "cuts": [
        {"at": "bilirubin", "scene": "spot", "params": {"s0": 3.5, "s1": 4.0, "az0": 1.0, "az1": 0.8}}
      ]
    },
    {
      "vo": "Green, then yellow, means your body is almost done. In about two weeks, it's gone.",
      "highlight": "#5dff9a",
      "scene": "timeline",
      "params": {"reveal0": 0.0},
      "cuts": [
        {"at": "yellow,", "scene": "spot", "params": {"s0": 3.6, "s1": 4.0, "az0": 0.9, "az1": 0.7}},
        {"at": "almost", "params": {"reveal0": -1, "ty0": -1, "ty1": -3, "dist0": 30, "dist1": 28}},
        {"at": "gone", "scene": "spot", "params": {"s0": 4.2, "s1": 5, "az0": 0.2, "az1": 0.1, "dist0": 13, "dist1": 15}}
      ]
    }
  ]
}
