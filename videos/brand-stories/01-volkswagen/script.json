        "x": 1250,
        "y": 420,
        "s": 0.88,
        "pose": "shrug",
        "expr": "annoyed",
        "turn": -0.3
       }
      ],
      "props": [],
      "stamp": "NO FUTURE"
     },
     "British car makers were offered the whole factory for free. They looked at the car, and decided it had no future."
    ],
    [
     "b01_7",
     {
      "bg": "road",
      "cast": [],
      "props": [
       {
