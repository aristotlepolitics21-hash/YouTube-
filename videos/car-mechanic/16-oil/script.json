   "lines": [
    [
     "c16_1",
     {
      "label": "hook",
      "head": "Oil is your engine's *blood*",
      "pose": "point",
      "face": "wow",
      "prop": {
       "type": "oilsys"
      }
     },
     "Without oil, an engine can destroy itself in minutes."
    ],
    [
